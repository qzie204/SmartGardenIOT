HOST=127.0.0.1
PORT=8080
# sqlite: không cần cài MySQL, tự tạo database trong file; mysql: theo báo cáo.
STORAGE_DRIVER=mysql
SQLITE_FILE=data/smart-garden.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_garden
DB_USER=smartgarden
DB_PASSWORD=replace_with_your_database_password
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
INTERNAL_API_KEY=replace_with_another_random_secret_at_least_32_characters
ALLOW_REGISTRATION=true
MQTT_URL=mqtt://172.20.10.2:1884
MQTT_USERNAME=replace_with_your_mqtt_username
MQTT_PASSWORD=replace_with_your_mqtt_password
MQTT_SENSOR_TOPIC=Qzie204/garden/data/sensors
MQTT_CONTROL_TOPIC=Qzie204/garden/device/control
MQTT_RESPONSE_TOPIC=Qzie204/garden/device/response
COMMAND_TIMEOUT_MS=10000
DEVICE_OFFLINE_MS=15000
